{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brian-eye-ledger-shadow",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "durable_objects": {
    "bindings": [
      {
        "name": "FIRST_SEEN_LEDGER",
        "class_name": "FirstSeenLedger"
      }
    ]
  },
  "exports": {
    "FirstSeenLedger": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "SHADOW_ONLY": "true",
    "LIVE_EXECUTION": "false",
    "ENABLE_SCHEDULED_EYE": "false",
    "R2_ENABLED": "false",
    "ALPHA_RECHECK_ENABLED": "false",
    "SUPABASE_INGEST_URL": "https://qbcjuxhvhwagvqbjyemo.supabase.co/functions/v1/brian-cloudflare-shadow-ingest",
    "SOURCE_MANIFEST_JSON": "[{\"endpoint_id\":\"cloudflare_pipeline_test\",\"source_id\":\"test:cloudflare:pipeline\",\"organization\":\"Brian Test Feed\",\"canonical_domain\":\"qbcjuxhvhwagvqbjyemo.supabase.co\",\"endpoint_url\":\"https://qbcjuxhvhwagvqbjyemo.supabase.co/functions/v1/brian-cloudflare-test-feed\",\"endpoint_kind\":\"RSS\",\"tier\":\"T1_OFFICIAL_PRIMARY\",\"category\":\"SHADOW_TEST\",\"region\":\"GLOBAL\",\"priority\":100}]"
  }
}
