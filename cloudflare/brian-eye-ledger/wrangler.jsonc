{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brian-eye-ledger-shadow",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "durable_objects": {
    "bindings": [
      {
        "name": "FIRST_SEEN_LEDGER",
        "class_name": "FirstSeenLedger"
      },
      {
        "name": "ALPHA_RECHECK_QUEUE",
        "class_name": "AlphaRecheckQueue"
      }
    ]
  },
  "exports": {
    "FirstSeenLedger": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "AlphaRecheckQueue": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "r2_buckets": [
    {
      "binding": "RAW_BUCKET",
      "bucket_name": "brian-raw-shadow"
    }
  ],
  "triggers": {
    "crons": []
  },
  "vars": {
    "SHADOW_ONLY": "true",
    "LIVE_EXECUTION": "false",
    "ENABLE_SCHEDULED_EYE": "false",
    "R2_ENABLED": "false",
    "ALPHA_RECHECK_ENABLED": "false",
    "CORE_RECOVERY_ENABLED": "false",
    "DURABLE_OBJECTS_ENABLED": "false",
    "R2_OUTBOX_ENABLED": "false",
    "REALTIME_ENGINES_ENABLED": "false",
    "DECOMMISSIONED": "true"
  }
}
