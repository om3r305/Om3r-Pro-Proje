{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brian-eye-ledger-shadow",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "durable_objects": {
    "bindings": [
      {
        "name": "FIRST_SEEN_LEDGER",
        "class_name": "FirstSeenLedger"
      }
    ]
  },
  "exports": {
    "FirstSeenLedger": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "SHADOW_ONLY": "true",
    "LIVE_EXECUTION": "false",
    "ENABLE_SCHEDULED_EYE": "false",
    "R2_ENABLED": "false",
    "ALPHA_RECHECK_ENABLED": "false",
    "SUPABASE_INGEST_URL": "https://qbcjuxhvhwagvqbjyemo.supabase.co/functions/v1/brian-cloudflare-shadow-ingest",
    "SOURCE_MANIFEST_JSON": "[{\"endpoint_id\":\"coinbase_status_atom\",\"source_id\":\"official:coinbase:status\",\"organization\":\"Coinbase Status\",\"canonical_domain\":\"status.coinbase.com\",\"endpoint_url\":\"https://status.coinbase.com/history.atom\",\"endpoint_kind\":\"STATUSPAGE_ATOM\",\"tier\":\"T1_OFFICIAL_PRIMARY\",\"category\":\"CRYPTO_EXCHANGE_STATUS\",\"region\":\"GLOBAL\",\"priority\":95}]"
  }
}
