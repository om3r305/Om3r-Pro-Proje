{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brian-eye-ledger-shadow",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "durable_objects": {
    "bindings": [
      {
        "name": "FIRST_SEEN_LEDGER",
        "class_name": "FirstSeenLedger"
      },
      {
        "name": "ALPHA_RECHECK_QUEUE",
        "class_name": "AlphaRecheckQueue"
      }
    ]
  },
  "exports": {
    "FirstSeenLedger": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "AlphaRecheckQueue": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "r2_buckets": [
    {
      "binding": "RAW_BUCKET",
      "bucket_name": "brian-raw-shadow"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "SHADOW_ONLY": "true",
    "LIVE_EXECUTION": "false",
    "ENABLE_SCHEDULED_EYE": "true",
    "R2_ENABLED": "true",
    "ALPHA_RECHECK_ENABLED": "true",
    "SUPABASE_INGEST_URL": "https://qbcjuxhvhwagvqbjyemo.supabase.co/functions/v1/brian-cloudflare-shadow-ingest",
    "ALPHA_RECHECK_URL": "https://qbcjuxhvhwagvqbjyemo.supabase.co/functions/v1/brian-cloudflare-alpha-recheck",
    "SOURCE_MANIFEST_JSON": "[{\"endpoint_id\":\"ecb_press\",\"source_id\":\"official:ecb:press\",\"organization\":\"ECB\",\"canonical_domain\":\"ecb.europa.eu\",\"endpoint_url\":\"https://www.ecb.europa.eu/rss/press.html\",\"endpoint_kind\":\"RSS\",\"tier\":\"T1_OFFICIAL_PRIMARY\",\"category\":\"CENTRAL_BANK\",\"region\":\"EU\",\"priority\":100},{\"endpoint_id\":\"boj_whatsnew_rss\",\"source_id\":\"official:boj:whatsnew\",\"organization\":\"Bank of Japan\",\"canonical_domain\":\"boj.or.jp\",\"endpoint_url\":\"https://www.boj.or.jp/en/rss/whatsnew.xml\",\"endpoint_kind\":\"RSS\",\"tier\":\"T1_OFFICIAL_PRIMARY\",\"category\":\"CENTRAL_BANK\",\"region\":\"JP\",\"priority\":95},{\"endpoint_id\":\"consilium_press\",\"source_id\":\"official:eucouncil:press\",\"organization\":\"Council of the EU\",\"canonical_domain\":\"consilium.europa.eu\",\"endpoint_url\":\"https://www.consilium.europa.eu/en/rss/pressreleases.ashx\",\"endpoint_kind\":\"RSS\",\"tier\":\"T1_OFFICIAL_PRIMARY\",\"category\":\"GEOPOLITICS_SANCTIONS\",\"region\":\"EU\",\"priority\":95},{\"endpoint_id\":\"bundesbank_general_rss\",\"source_id\":\"official:bundesbank:general\",\"organization\":\"Deutsche Bundesbank\",\"canonical_domain\":\"bundesbank.de\",\"endpoint_url\":\"https://www.bundesbank.de/service/rss/de/633290/feed.rss\",\"endpoint_kind\":\"RSS\",\"tier\":\"T1_OFFICIAL_PRIMARY\",\"category\":\"CENTRAL_BANK\",\"region\":\"DE\",\"priority\":90},{\"endpoint_id\":\"fed_monetary_rss\",\"source_id\":\"official:fed:monetary\",\"organization\":\"Federal Reserve Board\",\"canonical_domain\":\"federalreserve.gov\",\"endpoint_url\":\"https://www.federalreserve.gov/feeds/press_monetary.xml\",\"endpoint_kind\":\"RSS\",\"tier\":\"T1_OFFICIAL_PRIMARY\",\"category\":\"CENTRAL_BANK\",\"region\":\"US\",\"priority\":100},{\"endpoint_id\":\"sec_press_rss\",\"source_id\":\"official:sec:press\",\"organization\":\"U.S. Securities and Exchange Commission\",\"canonical_domain\":\"sec.gov\",\"endpoint_url\":\"https://www.sec.gov/news/pressreleases.rss\",\"endpoint_kind\":\"RSS\",\"tier\":\"T1_OFFICIAL_PRIMARY\",\"category\":\"FINANCIAL_REGULATION\",\"region\":\"US\",\"priority\":95},{\"endpoint_id\":\"boe_news_rss\",\"source_id\":\"official:boe:news\",\"organization\":\"Bank of England\",\"canonical_domain\":\"bankofengland.co.uk\",\"endpoint_url\":\"https://www.bankofengland.co.uk/rss/news\",\"endpoint_kind\":\"RSS\",\"tier\":\"T1_OFFICIAL_PRIMARY\",\"category\":\"CENTRAL_BANK\",\"region\":\"UK\",\"priority\":95},{\"endpoint_id\":\"ustreasury_press_html\",\"source_id\":\"official:ustreasury:press\",\"organization\":\"U.S. Department of the Treasury\",\"canonical_domain\":\"home.treasury.gov\",\"endpoint_url\":\"https://home.treasury.gov/news/press-releases\",\"endpoint_kind\":\"HTML_LINKS\",\"html_path_prefix\":\"/news/press-releases/\",\"tier\":\"T1_OFFICIAL_PRIMARY\",\"category\":\"TREASURY_POLICY_SANCTIONS\",\"region\":\"US\",\"priority\":95},{\"endpoint_id\":\"cftc_press_html\",\"source_id\":\"official:cftc:press\",\"organization\":\"U.S. Commodity Futures Trading Commission\",\"canonical_domain\":\"cftc.gov\",\"endpoint_url\":\"https://www.cftc.gov/PressRoom/PressReleases\",\"endpoint_kind\":\"HTML_LINKS\",\"html_path_prefix\":\"/PressRoom/PressReleases/\",\"tier\":\"T1_OFFICIAL_PRIMARY\",\"category\":\"FINANCIAL_REGULATION_DERIVATIVES\",\"region\":\"US\",\"priority\":95},{\"endpoint_id\":\"nyfed_press_html\",\"source_id\":\"official:nyfed:press\",\"organization\":\"Federal Reserve Bank of New York\",\"canonical_domain\":\"newyorkfed.org\",\"endpoint_url\":\"https://www.newyorkfed.org/newsevents/news/index\",\"endpoint_kind\":\"HTML_LINKS\",\"html_path_prefix\":\"/newsevents/news/\",\"tier\":\"T1_OFFICIAL_PRIMARY\",\"category\":\"CENTRAL_BANK_MARKETS\",\"region\":\"US\",\"priority\":100},{\"endpoint_id\":\"bis_media_rss\",\"source_id\":\"official:bis:media\",\"organization\":\"Bank for International Settlements\",\"canonical_domain\":\"bis.org\",\"endpoint_url\":\"https://www.bis.org/doclist/all_pressrels.rss\",\"endpoint_kind\":\"RSS\",\"tier\":\"T1_OFFICIAL_PRIMARY\",\"category\":\"GLOBAL_FINANCIAL_STABILITY\",\"region\":\"GLOBAL\",\"priority\":95},{\"endpoint_id\":\"boc_press_rss\",\"source_id\":\"official:boc:press\",\"organization\":\"Bank of Canada\",\"canonical_domain\":\"bankofcanada.ca\",\"endpoint_url\":\"https://www.bankofcanada.ca/content_type/press-releases/feed/\",\"endpoint_kind\":\"RSS\",\"tier\":\"T1_OFFICIAL_PRIMARY\",\"category\":\"CENTRAL_BANK\",\"region\":\"CA\",\"priority\":95}]",
    "CORE_RECOVERY_ENABLED": "true",
    "CORE_LAUNCHER_URL": "https://qbcjuxhvhwagvqbjyemo.supabase.co/functions/v1/brian-core-launcher",
    "DURABLE_OBJECTS_ENABLED": "false",
    "R2_OUTBOX_ENABLED": "true",
    "REALTIME_INGEST_URL": "https://dliediwlldojkfjzlznm.supabase.co/functions/v1/brian-cloudflare-shadow-ingest",
    "REALTIME_ALPHA_RECHECK_URL": "https://dliediwlldojkfjzlznm.supabase.co/functions/v1/brian-cloudflare-alpha-recheck",
    "REALTIME_ENGINES_ENABLED": "true",
    "REALTIME_UNIVERSE_URL": "https://dliediwlldojkfjzlznm.supabase.co/functions/v1/brian-universe-collector",
    "REALTIME_SENSOR_URL": "https://dliediwlldojkfjzlznm.supabase.co/functions/v1/brian-sensor-mesh",
    "REALTIME_INTRABAR_URL": "https://dliediwlldojkfjzlznm.supabase.co/functions/v1/brian-intrabar-eye"
  }
}
