{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brian-eye-ledger-shadow",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "durable_objects": {
    "bindings": [
      {
        "name": "FIRST_SEEN_LEDGER",
        "class_name": "FirstSeenLedger"
      }
    ]
  },
  "exports": {
    "FirstSeenLedger": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "r2_buckets": [
    {
      "binding": "RAW_BUCKET",
      "bucket_name": "brian-raw-shadow"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "SHADOW_ONLY": "true",
    "LIVE_EXECUTION": "false",
    "ENABLE_SCHEDULED_EYE": "true",
    "R2_ENABLED": "true",
    "ALPHA_RECHECK_ENABLED": "false",
    "SUPABASE_INGEST_URL": "https://qbcjuxhvhwagvqbjyemo.supabase.co/functions/v1/brian-cloudflare-shadow-ingest",
    "SOURCE_MANIFEST_JSON": "[{\"endpoint_id\":\"ecb_press\",\"source_id\":\"official:ecb:press\",\"organization\":\"ECB\",\"canonical_domain\":\"ecb.europa.eu\",\"endpoint_url\":\"https://www.ecb.europa.eu/rss/press.html\",\"endpoint_kind\":\"RSS\",\"tier\":\"T1_OFFICIAL_PRIMARY\",\"category\":\"CENTRAL_BANK\",\"region\":\"EU\",\"priority\":100},{\"endpoint_id\":\"boj_whatsnew_rss\",\"source_id\":\"official:boj:whatsnew\",\"organization\":\"Bank of Japan\",\"canonical_domain\":\"boj.or.jp\",\"endpoint_url\":\"https://www.boj.or.jp/en/rss/whatsnew.xml\",\"endpoint_kind\":\"RSS\",\"tier\":\"T1_OFFICIAL_PRIMARY\",\"category\":\"CENTRAL_BANK\",\"region\":\"JP\",\"priority\":95},{\"endpoint_id\":\"consilium_press\",\"source_id\":\"official:eucouncil:press\",\"organization\":\"Council of the EU\",\"canonical_domain\":\"consilium.europa.eu\",\"endpoint_url\":\"https://www.consilium.europa.eu/en/rss/pressreleases.ashx\",\"endpoint_kind\":\"RSS\",\"tier\":\"T1_OFFICIAL_PRIMARY\",\"category\":\"GEOPOLITICS_SANCTIONS\",\"region\":\"EU\",\"priority\":95},{\"endpoint_id\":\"bundesbank_general_rss\",\"source_id\":\"official:bundesbank:general\",\"organization\":\"Deutsche Bundesbank\",\"canonical_domain\":\"bundesbank.de\",\"endpoint_url\":\"https://www.bundesbank.de/service/rss/de/633290/feed.rss\",\"endpoint_kind\":\"RSS\",\"tier\":\"T1_OFFICIAL_PRIMARY\",\"category\":\"CENTRAL_BANK\",\"region\":\"DE\",\"priority\":90}]"
  }
}
